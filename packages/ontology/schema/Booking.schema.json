      "title": "Bags",
      "type": "array"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Currency code",
      "title": "Currency"
    },
    "customer_cancelled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Customer initiated the cancellation",
      "title": "Customer Cancelled"
    },
    "days_until_departure_at_purchase": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Days between purchase and first departure",
      "title": "Days Until Departure At Purchase"
    },
    "fare_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fare family: saver, main, first, premium",
      "title": "Fare Class"
    },
    "flights": {
      "description": "Segments",
      "items": {
        "$ref": "#/$defs/Flight"
      },
      "title": "Flights",
      "type": "array"
    },
    "hours_since_purchase": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hours between purchase and the request",
      "title": "Hours Since Purchase"
    },
    "hours_until_departure": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hours between the request and first departure",
      "title": "Hours Until Departure"
    },
    "is_refundable_fare": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fare is refundable to original form of payment",
      "title": "Is Refundable Fare"
    },
    "loyalty_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Loyalty account number (masked)",
      "title": "Loyalty Number"
    },
    "paid_with_credit_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Portion paid with travel credit",
      "title": "Paid With Credit Amount"
    },
    "payment_method": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaymentMethod"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Original form of payment"
    },
    "pnr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Confirmation code",
      "title": "Pnr"
    },
    "purchased_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the ticket was purchased",
      "title": "Purchased At"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "active, flown, cancelled_by_customer, cancelled_by_airline, no_show",
      "title": "Status"
    },
    "ticket_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "E-ticket number",
      "title": "Ticket Number"
    },
    "total_paid": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Total fare paid including taxes and fees",
      "title": "Total Paid"
    },
    "travel_completed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "All segments flown",
      "title": "Travel Completed"
    }
  },
  "title": "Booking",
  "type": "object"
}
