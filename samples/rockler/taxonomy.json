  {
   "key": "damaged_on_arrival",
   "name": "Item Damaged in Transit",
   "description": "Customers report that tools or supplies arrived physically damaged, such as crushed crates, chipped edges, leaking finish, or broken bottles, and request a refund or replacement.",
   "volume": 105,
   "avg_hours": 15.01,
   "pain_score": 1576.05
  },
  {
   "key": "change_of_mind_returns",
   "name": "Change of Mind Returns",
   "description": "Customers want to return or get a refund for woodworking tools, parts, or downloadable plans simply because they changed plans, found it cheaper elsewhere, or no longer need the item, not because of a defect or shipping error.",
   "volume": 91,
   "avg_hours": 7.96,
   "pain_score": 724.36
  },
  {
   "key": "lifetime_guarantee_wear_failure",
   "name": "Lifetime Guarantee Wear Failure",
   "description": "Customers claim under the lifetime guarantee that router bits or drawer slides failed after years of normal use, such as seized bearings, snapped carbide tips, or worn-out cutting performance, and request a replacement.",
   "volume": 26,
   "avg_hours": 25.49,
   "pain_score": 662.74
  },
  {
   "key": "cancel_backordered_order",
   "name": "Cancel Backordered Order",
   "description": "Customers want to cancel orders containing items that are on backorder and receive a refund, with staff sometimes approving and sometimes denying the cancellation under policy.",
   "volume": 21,
   "avg_hours": 3.35,
   "pain_score": 70.35
  },
  {
   "key": "backorder_eta_inquiry",
   "name": "Backorder Shipping ETA Inquiry",
   "description": "Customers ask when backordered items will ship and receive no firm date, often with staff offering cancellation or a status update instead.",
   "volume": 17,
   "avg_hours": 2.79,
   "pain_score": 47.43
  },
  {
   "key": "cancel_shipped_order",
   "name": "Cancel Shipped Order",
   "description": "Customers request cancellation and refund of orders that have already shipped, usually after changing their mind or ordering the wrong item, and staff typically deny the cancellation and redirect to returns or store credit.",
   "volume": 21,
   "avg_hours": 2.16,
   "pain_score": 45.36
  },
  {
   "key": "post_shipment_quantity_change",
   "name": "Quantity Change After Shipment",
   "description": "Customers request increasing item quantities on orders that have already shipped, which staff deny because shipped orders cannot be modified.",
   "volume": 12,
   "avg_hours": 1.62,
   "pain_score": 19.44
  },
  {
   "key": "shipping_address_change_denied",
   "name": "Shipping Address Change Denied",
   "description": "Customers request a shipping address correction or move on an order after checkout, and staff decline because the order has already shipped or fallen outside policy.",
   "volume": 7,
   "avg_hours": 1.62,
   "pain_score": 11.34
  }
