# --- LLM ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude            # claude | opensource
CLAUDE_MODEL=                  # Haiku model id, used for every runtime call
DAILY_COST_CAP_USD=
LLM_BATCH=                     # true (default, 50% price, slow) | false (synchronous, fast)

# --- Embeddings ---
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=            # auto | voyage | local (auto = voyage if key set, else local hash embeddings)

# --- Database ---
DATABASE_URL=                  # default pgserver://.pgdata (embedded dev DB). Docker: postgresql+psycopg://umpyr:umpyr@localhost:5432/umpyr

# --- Engine ---
ENGINE_ENV=                    # dev | prod
DATA_RETENTION_DAYS=           # default 14

# --- Web app (Vite) ---
VITE_API_BASE_URL=             # http://localhost:8000
ASSUME_REFERENCE_EXISTS=
