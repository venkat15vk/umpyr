# --- LLM ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude            # claude | opensource
CLAUDE_MODEL=                  # Haiku model id, used for every runtime call
DAILY_COST_CAP_USD=
LLM_BATCH=                     # true (default, 50% price, slow) | false (synchronous, fast)

# --- Embeddings ---
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=            # auto | voyage | local (auto = voyage if key set, else local hash embeddings)

# --- Database ---
DATABASE_URL=                  # default pgserver://.pgdata (embedded dev DB). Docker: postgresql+psycopg://umpyr:umpyr@localhost:5432/umpyr

# --- Engine ---
ENGINE_ENV=                    # dev | prod
DATA_RETENTION_DAYS=           # default 14

# --- Web app (Vite) ---
VITE_API_BASE_URL=             # http://localhost:8000
ASSUME_REFERENCE_EXISTS=
API_GATEWAY_SECRET=
CORS_ORIGINS=
VITE_PUBLIC_DEMO=

# --- Deployment (used only by infra/deploy.sh; see infra/DEPLOY.md) ---
RAILWAY_API_TOKEN=             # account token, or skip and `railway login` once
RAILWAY_TOKEN=
RAILWAY_SERVICE=
RAILWAY_WORKSPACE=             # optional; workspace name/id for `railway init`
DAILY_COST_CAP_USD_PROD=       # daily Haiku cap for the public demo (default 1)
PUBLIC_HOST=                   # default www.umpyr.org; e.g. demo.umpyr.org
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT=
DEMO_PASSWORD=
SESSION_SECRET=
API_ORIGIN=
PUBLIC_ORIGIN=
